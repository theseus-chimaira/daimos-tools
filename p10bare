# Mnemonics that must not slip into PDP-6/KA10 baseline tests.
# The local assembler can encode some later-machine mnemonics for convenience,
# so p10bare must reject them before assembly when the selected machine cannot
# execute them.  This keeps semantic test passes honest.
FORBIDDEN_MNEMONICS = {
    'pdp6': set(['adjsp', 'dmove', 'dmovem', 'dmovn', 'dmovnm', 'xmovei']),
    'ka10': set(['adjsp', 'dmove', 'dmovem', 'dmovn', 'dmovnm', 'xmovei']),
    'ki10': set(['adjsp', 'xmovei']),
    'ks10': set(),   # ks10/kl10 can use the extended instructions
    'kl10': set(),
}


def strip_asm_comment(line: str) -> str:
    return line.split(';', 1)[0]


def asm_mnemonic_from_line(line: str) -> Optional[str]:
    text = strip_asm_comment(line).strip()
    if not text or text.startswith('.'):
        return None
    if ':' in text:
        left, right = text.split(':', 1)
        if re.match(r'^[A-Za-z_%.$][A-Za-z0-9_%.$]*$', left.strip()):
            text = right.strip()
            if not text or text.startswith('.'):
                return None
    m = re.match(r'^([A-Za-z][A-Za-z0-9.]*)\b', text)
    if not m:
        return None
    return m.group(1).lower()


def check_machine_mnemonics(machine: str, sources: Sequence[Path]) -> None:
    forbidden = FORBIDDEN_MNEMONICS.get(machine, set())
    if not forbidden:
        return
    bad: List[str] = []
    for src in sources:
        try:
            lines = src.read_text(errors='replace').splitlines()
        except Exception as exc:
            raise SystemExit('cannot read assembly for ISA check: %s: %s' % (src, exc))
        for nr, line in enumerate(lines, 1):
            mnem = asm_mnemonic_from_line(line)
            if mnem in forbidden:
                bad.append('%s:%d: %s' % (src, nr, line.strip()))
    if bad:
        msg = ['selected machine %s cannot use these mnemonics:' % machine]
        msg.extend(bad[:40])
        if len(bad) > 40:
            msg.append('... %d more' % (len(bad) - 40))
        raise SystemExit('\n'.join(msg))


def octint(text: object) -> int:
    s = str(text).strip()
    if s.startswith(('0o', '0O')):
        return int(s, 8)
    return int(s, 8)


def fmt36(value: int) -> str:
    return '%012o' % (int(value) & MASK36)


def sha256_file(path: Path) -> str:
    try:
        h = hashlib.sha256()
        with path.open('rb') as f:
            for block in iter(lambda: f.read(65536), b''):
                h.update(block)
        return h.hexdigest()
    except Exception:
        return '?'


def load_module_from_path(name: str, path: Path):
    if not path.exists():
        raise SystemExit('missing %s: %s' % (name, path))
    spec = importlib.util.spec_from_file_location(name, str(path))
    if spec is None or spec.loader is None:
        raise SystemExit('cannot load %s from %s' % (name, path))
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)  # type: ignore[attr-defined]
    return mod


def parse_expect(items: Sequence[str]) -> List[Tuple[str, int]]:
    out: List[Tuple[str, int]] = []
    for item in items:
        if '=' not in item:
            raise SystemExit('bad --expect %r, expected LABEL=OCTAL' % item)
        name, value = item.split('=', 1)
        name = name.strip()
        if not name:
            raise SystemExit('bad --expect %r: empty label' % item)
        out.append((name, octint(value)))
    return out


def resolve_sources(sources: Sequence[str], workdir: Path) -> List[Path]:
    out: List[Path] = []
    for item in sources:
        p = Path(item).expanduser()
        if not p.is_absolute():
            p = (Path.cwd() / p).resolve()
        if not p.exists():
            q = (workdir / item).expanduser().resolve()
            if q.exists():
                p = q
        if not p.exists():
            raise SystemExit('source not found: %s' % item)
        out.append(p)
    return out


def compile_c_source(gcc: Path, src: Path, out_s: Path, machine: str,
                     extra_flags: Sequence[str]) -> None:
    """
    Compile C source to assembly using the PDP-10 gcc driver (preferred).
    Compilation now always goes through the gcc driver (pdp10-dec-none-gcc -S).
    """
    march = DEFAULT_MARCH[machine]
    cmd = [
        str(gcc),
        '-S',                    # stop after compilation, produce .s
        '-O2',
        '-fno-builtin',
        '-fno-common',
        f'-march={march}',
    ]
    cmd.extend(extra_flags)
    cmd.extend([str(src), '-o', str(out_s)])

    out_s.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout)
        raise SystemExit('gcc driver failed with rc=%d: %s' % (proc.returncode, ' '.join(shlex.quote(x) for x in cmd)))


def prepare_assembly_sources(args, workdir: Path, sources: Sequence[Path]) -> List[Path]:
    asm_sources: List[Path] = prepare_libgcc1_sources(args, workdir)
    gen_dir = workdir / 'p10bare-gen'
    for src in sources:
        suffix = src.suffix.lower()
        if suffix == '.c':
            out_s = gen_dir / (src.stem + '.s')
            # Use the gcc driver (pdp10-dec-none-gcc)
            driver_flags = args.gcc_extra or []
            compile_c_source(PDP10_GCC, src, out_s, args.machine, driver_flags)
            asm_sources.append(out_s)
        else:
            asm_sources.append(src)
    return asm_sources


def assemble_sources(pdp10_asm, sources: Sequence[Path], start_addr: int):
    lines: List[str] = []
    for unit, filename in enumerate(sources, 1):
        lines.append('.pdp10_unit %d\n' % unit)
        lines.append('.text\n')
        with filename.open('r') as f:
            lines.extend(f.readlines())
        lines.append('\n.text\n')
    words, labels, pool = pdp10_asm.assemble(lines, start_addr)
    return words, labels, pool


def combine_assembly_sources(sources: Sequence[Path], path: Path) -> None:
    comment_width = 120
    with path.open('w') as out:
        for unit, filename in enumerate(sources, 1):
            prefix = '; p10bare unit %d: ' % unit
            name = str(filename)
            first_width = max(1, comment_width - len(prefix))
            out.write(prefix + name[:first_width] + '\n')
            name = name[first_width:]
            while name:
                out.write('; ' + name[:comment_width - 2] + '\n')
                name = name[comment_width - 2:]
            out.write('.text\n')
            with filename.open('r') as f:
                out.writelines(f.readlines())
            out.write('\n.text\n')


def read_label_file(path: Path, start_addr: int) -> Dict[str, int]:
    labels: Dict[str, int] = {}
    if path.exists():
        for line in path.read_text(errors='replace').splitlines():
            parts = line.split()
            if len(parts) >= 2 and re.match(r'^[0-7]+$', parts[1]):
                labels[parts[0]] = start_addr + int(parts[1], 8)
    labels.setdefault('__start', start_addr)
    return labels


def assemble_with_binary(assembler_path: Path, sources: Sequence[Path],
                         start_addr: int, workdir: Path, base_name: str):
    """
    Drive the installed DAS-compatible pdp10-dec-none-as as an opaque
    executable.  DAS emits DXR plus a label sidecar; dxrconvert handles
    SIMH/RIM conversion later.
    """
    combined = workdir / (base_name + '-combined.s')
    dxr_path = workdir / (base_name + '.dxr')
    label_path = workdir / (base_name + '.labels')
    combine_assembly_sources(sources, combined)
    cmd = [str(assembler_path), '--labels', str(label_path),
           '-o', str(dxr_path), str(combined)]
    try:
        subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=TOOL_TIMEOUT)
    except subprocess.TimeoutExpired as e:
        raise SystemExit(f"pdp10-dec-none-as timed out after {TOOL_TIMEOUT}s: {' '.join(cmd)}")
    except subprocess.CalledProcessError as e:
        sys.stderr.write(e.stdout or '')
        sys.stderr.write(e.stderr or '')
        raise SystemExit(f"pdp10-dec-none-as failed (rc={e.returncode})")
    return dxr_path, read_label_file(label_path, start_addr)


def entry_for(labels: Dict[str, int], start_addr: int) -> int:
    return labels.get('__start', labels.get('start', labels.get('main', start_addr)))


def write_deposit(words: Iterable[Tuple[int, int]], labels: Dict[str, int],
                  start_addr: int, path: Path) -> int:
    entry = entry_for(labels, start_addr)
    with path.open('w') as f:
        for addr, val in sorted(words):
            f.write('deposit %o %012o\n' % (addr, val & MASK36))
        f.write('; entry at %o\n' % entry)
    return entry


def convert_dxr(dxr_path: Path, out_path: Path, mode: str, start_addr: int) -> None:
    cmd = [str(DXRCONVERT), '--' + mode, '-b', format(start_addr, 'o')]
    # p10bare controls execution after loading the image.  In SIMH deposit
    # mode, dxrconvert's default trailing `go` would start the program while
    # the image file is being sourced, before p10bare can install its
    # low-core breakpoint or bounded step limit.
    if mode == 'simh':
        cmd.append('--no-go')
    cmd.extend([str(dxr_path), str(out_path)])
    try:
        subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=TOOL_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise SystemExit(f"dxrconvert timed out after {TOOL_TIMEOUT}s: {' '.join(cmd)}")
    except subprocess.CalledProcessError as e:
        sys.stderr.write(e.stdout or '')
        sys.stderr.write(e.stderr or '')
        raise SystemExit(f"dxrconvert failed (rc={e.returncode})")


def write_rim(mkrim, words: Iterable[Tuple[int, int]], labels: Dict[str, int],
              start_addr: int, path: Path) -> int:
    entry = entry_for(labels, start_addr)
    wdict = dict(words)
    tape = mkrim.make_rim10b(wdict, entry)
    with path.open('wb') as f:
        f.write(tape)
    return entry


def write_rim_with_binary(mkrim_path: Path, asm_sources: Sequence[Path],
                          start_addr: int, path: Path) -> int:
    """
    Drive the installed mkrim binary as a subprocess for symmetry with the assembler.
    It will re-assemble the sources and produce the RIM image.
    We use the entry computed from the assembler step for consistency.
    """
    entry = start_addr  # will be overridden by mkrim output if possible
    cmd = [str(mkrim_path), format(int(start_addr), 'o')] + [str(p) for p in asm_sources]
    env = os.environ.copy()
    env.setdefault('PDP10_AS', str(PDP10_ASM))
    try:
        result = subprocess.run(cmd, capture_output=True, text=False, env=env, timeout=TOOL_TIMEOUT)
        if result.returncode != 0:
            sys.stderr.write(result.stderr.decode('utf-8', errors='replace') if result.stderr else '')
            raise SystemExit(f"mkrim failed with rc={result.returncode}")
        with path.open('wb') as f:
            f.write(result.stdout)

        # Try to extract entry from the stderr comment the mkrim binary prints
        stderr_text = result.stderr.decode('utf-8', errors='replace') if result.stderr else ''
        m = re.search(r'entry=(\d+)', stderr_text)
        if m:
            entry = int(m.group(1), 8)
        return entry
    except Exception as e:
        raise SystemExit(f"Failed to run mkrim binary: {e}")


def write_labels(labels: Dict[str, int], path: Path) -> None:
    with path.open('w') as f:
        for name in sorted(labels):
            f.write('%-32s %06o\n' % (name, labels[name]))


def get_pdp10_share_dir() -> Path:
    """Return the system data directory for pdp10-tools INI files.

    Search order (first match wins):
    1. $PDP10_DATADIR
    2. $PDP10_PREFIX/share/pdp10-tools
    """
    # 1. Explicit data dir override (preferred)
    for var in ('PDP10_DATADIR', 'DATADIR'):
        if var in os.environ:
            return Path(os.environ[var]).expanduser().resolve()

    # 2. Prefix-based
    return PDP10_PREFIX / 'share' / 'pdp10-tools'


def find_default_ini(machine: str, workdir: Path, toolsdir: Path) -> List[Path]:
    seen = set()
    out: List[Path] = []
    share_dir = get_pdp10_share_dir()

    # Search order for each base: direct + common subdirectories (ini/, simh/)
    subdirs = ['', 'ini', 'simh']
    for base in (workdir, toolsdir, share_dir):
        for sub in subdirs:
            cand = base / sub if sub else base
            for name in DEFAULT_INI_NAMES.get(machine, ()):
                p = (cand / name).resolve()
                if str(p) in seen:
                    continue
                seen.add(str(p))
                if p.exists():
                    out.append(p)
    return out


def resolve_ini(ini: str, workdir: Path, toolsdir: Path) -> Path:
    p = Path(ini).expanduser()
    if p.is_absolute() and p.exists():
        return p.resolve()

    share_dir = get_pdp10_share_dir()

    candidates = [
        Path.cwd() / p,
        workdir / p,
        toolsdir / p,
        share_dir / p,
    ]

    # Also try common subdirectories (ini/, simh/)
    for base in (workdir, toolsdir, share_dir):
        for sub in ('ini', 'simh'):
            candidates.append(base / sub / p)

    for q in candidates:
        q = q.expanduser().resolve()
        if q.exists():
            return q
    raise SystemExit('ini file not found: %s' % ini)


def make_run_script(args, machine: str, labels: Dict[str, int], entry: int,
                    image_path: Path, expects: Sequence[Tuple[str, int]],
                    ini_files: Sequence[Path]) -> str:
    lines: List[str] = []
    lines.append('echo __P10BARE_START__ machine=%s mode=%s entry=%o' % (machine, args.mode, entry))
    for ini in ini_files:
        lines.append('echo __P10BARE_INI__ %s' % ini)
        lines.append('do %s' % ini)
    for cmd in args.set:
        lines.append(cmd)

    if args.mode == 'rim':
        lines.append('load %s' % image_path)
    else:
        lines.append('do %s' % image_path)

    # In the bare harness, code is loaded at the selected entry address
    # (normally 01000).  Falling into low-core zero words is a crash, not
    # useful execution.  Stop there so bad return addresses/UUOs become
    # deterministic expectation failures instead of long SIMH timeouts.
    lines.append('echo __P10BARE_LOW_CORE_BREAK__ 20')
    lines.append('break 20')

    if args.exec_mode == 'step':
        lines.append('echo __P10BARE_RUN__ STEP %s PC=%o' % (args.step_limit, entry))
        lines.append('deposit %s %o' % (args.pc_reg, entry))
        lines.append('examine %s' % args.pc_reg)
        lines.append('step %s' % args.step_limit)
    else:
        lines.append('echo __P10BARE_RUN__ GO %o' % entry)
        lines.append('go %o' % entry)

    lines.append('echo __P10BARE_AFTER_RUN__')
    lines.append('examine %s' % args.pc_reg)

    for name, want in expects:
        if name not in labels:
            raise SystemExit('expected label not found: %s' % name)
        addr = labels[name]
        lines.append('echo __P10BARE_EXPECT__ %s %o %012o' % (name, addr, want & MASK36))
        lines.append('examine %o' % addr)

    for item in args.examine:
        if item in labels:
            addr = labels[item]
            lines.append('echo __P10BARE_EXAMINE__ %s %o' % (item, addr))
            lines.append('examine %o' % addr)
        else:
            lines.append('echo __P10BARE_EXAMINE__ %s' % item)
            lines.append('examine %s' % item)

    lines.append('quit')
    return '\n'.join(lines) + '\n'


def extract_octal_words(line: str) -> List[int]:
    out: List[int] = []
    for tok in re.findall(r'(?<![0-9A-Za-z])[0-7]{1,12}(?![0-9A-Za-z])', line):
        try:
            out.append(int(tok, 8) & MASK36)
        except ValueError:
            pass
    return out


def parse_marked_values(output: str, marker: str):
    values = []
    lines = output.splitlines()
    pat = re.compile(r'%s\s+(\S+)\s+([0-7]+)(?:\s+([0-7]{1,12}))?' % re.escape(marker))
    for i, line in enumerate(lines):
        m = pat.search(line)
        if not m:
            continue
        name = m.group(1)
        addr = int(m.group(2), 8)
        want = int(m.group(3), 8) & MASK36 if m.group(3) else None
        got = None
        got_line = None
        for j in range(i + 1, min(len(lines), i + 10)):
            words = extract_octal_words(lines[j])
            if words:
                got = words[-1]
                got_line = lines[j]
                break
        values.append({'name': name, 'addr': addr, 'want': want, 'got': got, 'line': got_line})
    return values


def write_report(path: Path, args, machine: str, simh: Path, assembler: Path,
                 mkrim_path: Path, gcc_driver: Path, start_pwd: Path, workdir: Path,
                 toolsdir: Path, start_addr: int, entry: int,
                 sources: Sequence[Path], asm_sources: Sequence[Path],
                 ini_files: Sequence[Path], labels: Dict[str, int], rc: int,
                 output: str, failures: Sequence[str], artifacts: Dict[str, Path]) -> None:
    with path.open('w') as f:
        def section(title: str):
            f.write('\n========== %s ==========' % title)
            f.write('\n')

        section('p10bare report')
        f.write('start_pwd=%s\n' % start_pwd)
        f.write('workdir=%s\n' % workdir)
        f.write('toolsdir=%s\n' % toolsdir)
        f.write('machine=%s\n' % machine)
        f.write('mode=%s\n' % args.mode)
        f.write('exec_mode=%s\n' % args.exec_mode)
        f.write('start=%o\n' % start_addr)
        f.write('entry=%o\n' % entry)
        f.write('step_limit=%s\n' % args.step_limit)
        f.write('timeout=%s\n' % args.timeout)
        f.write('assembler=%s\n' % assembler)
        f.write('assembler_sha256=%s\n' % sha256_file(assembler))
        f.write('mkrim=%s\n' % mkrim_path)
        f.write('mkrim_sha256=%s\n' % sha256_file(mkrim_path))
        f.write('gcc=%s\n' % gcc_driver)
        f.write('gcc_sha256=%s\n' % sha256_file(gcc_driver))
        f.write('simh=%s\n' % simh)
        f.write('simh_sha256=%s\n' % sha256_file(simh))
        f.write('rc=%s\n' % rc)
        f.write('result=%s\n' % ('PASS' if rc == 0 and not failures else 'FAIL'))

        section('default ini files')
        if ini_files:
            for ini in ini_files:
                f.write('%s\n' % ini)
        else:
            f.write('none\n')

        section('input sources')
        for s in sources:
            f.write('%s\n' % s)

        section('assembly sources')
        for s in asm_sources:
            f.write('%s\n' % s)

        section('artifacts')
        for k, v in artifacts.items():
            f.write('%-12s %s\n' % (k + ':', v))

        section('expectations')
        parsed = parse_marked_values(output, '__P10BARE_EXPECT__')
        if parsed:
            for item in parsed:
                got = '?' if item['got'] is None else fmt36(item['got'])
                want = '?' if item['want'] is None else fmt36(item['want'])
                ok = item['got'] is not None and item['want'] is not None and (((item['got'] ^ item['want']) & MASK36) == 0)
                f.write('%-28s @ %06o got=%s want=%s %s\n' % (item['name'], item['addr'], got, want, 'OK' if ok else 'FAIL'))
        else:
            f.write('no expectation markers parsed\n')

        section('extra examines')
        parsed_ex = parse_marked_values(output, '__P10BARE_EXAMINE__')
        if parsed_ex:
            for item in parsed_ex:
                got = '?' if item['got'] is None else fmt36(item['got'])
                f.write('%-28s @ %06o got=%s\n' % (item['name'], item['addr'], got))
        else:
            f.write('no extra examine markers parsed\n')

        section('failures')
        if failures:
            for fail in failures:
                f.write('FAIL: %s\n' % fail)
        else:
            f.write('none\n')

        section('simh output')
        f.write(output)
        if output and not output.endswith('\n'):
            f.write('\n')

        section('labels')
        for name in sorted(labels):
            f.write('%-32s %06o\n' % (name, labels[name]))


def main(argv: Optional[Sequence[str]] = None) -> int:
    p = argparse.ArgumentParser(description='assemble/run PDP-6/KA10/KI10/KS10/KL10 SIMH bare tests')
    p.add_argument('--version', action='store_true', help='print version and exit')
    p.add_argument('--machine', default='ka10', choices=['pdp6', 'ka10', 'ki10', 'ks10', 'kl10'])
    p.add_argument('--mode', choices=['rim', 'deposit'], default='rim', help='image mode; default rim')
    p.add_argument('--start', default=None, help='octal load/start address, default 1000')
    p.add_argument('--workdir', default=None, help='artifact directory, default current directory')
    p.add_argument('--name', default=None, help='artifact base name, default first source stem')
    p.add_argument('--exec-mode', choices=['step', 'go'], default='step')
    p.add_argument('--step-limit', default=os.environ.get('STEP_LIMIT', '2000000'))
    p.add_argument('--timeout', type=int, default=int(os.environ.get('TIMEOUT', '120')))
    p.add_argument('--pc-reg', default=os.environ.get('SIMH_PC_REG', 'PC'))
    p.add_argument('--expect', action='append', default=[], help='LABEL=OCTAL')
    p.add_argument('--examine', action='append', default=[], help='LABEL or SIMH address/register')
    p.add_argument('--set', action='append', default=[], help='extra SIMH command after ini and before load/deposit')
    p.add_argument('--ini', action='append', default=[], help='extra/explicit SIMH ini file; searched in cwd, workdir, toolsdir')
    p.add_argument('--no-default-ini', action='store_true', help='do not auto-load simh.ini/machine ini from workdir/toolsdir')
    p.add_argument('--gcc-extra', action='append', default=[], help='additional flag passed to pdp10-dec-none-gcc for .c -> .s')
    p.add_argument('--libgcc1', default=None, help='preprocess gcc/config/pdp10/libgcc1.s and prepend bare runtime helper sources')
    p.add_argument('--cpp', default=os.environ.get('CPP', 'cpp'), help='C preprocessor used by --libgcc1')
    p.add_argument('--regparm', default=os.environ.get('REGPARM', '4'), help='__REGPARM__ value used by --libgcc1')
    p.add_argument('--underscore', default=os.environ.get('UNDERSCORE', '_'), help='UNDERSCORE value used by --libgcc1')
    p.add_argument('--report', default=None, help='report path, default WORKDIR/NAME.report.txt')
    p.add_argument('sources', nargs='*')
    args = p.parse_args(argv)
    if args.version:
        print(P10BARE_VERSION)
        return 0
    if not args.sources:
        p.error('sources required')

    start_pwd = Path.cwd().resolve()
    workdir = Path(args.workdir).expanduser().resolve() if args.workdir else start_pwd
    toolsdir = SCRIPT_DIR
    workdir.mkdir(parents=True, exist_ok=True)

    machine = args.machine
    simh = SIMH[machine]
    if not simh.exists():
        raise SystemExit('missing SIMH emulator for %s: %s' % (machine, simh))
    if not PDP10_ASM.exists():
        raise SystemExit('missing assembler (checked system + local): %s' % PDP10_ASM)
    start_addr = octint(args.start or DEFAULT_START[machine])
    raw_sources = resolve_sources(args.sources, workdir)
    asm_sources = prepare_assembly_sources(args, workdir, raw_sources)
    check_machine_mnemonics(machine, asm_sources)
    base_name = args.name or raw_sources[0].stem

    # Prefer direct module import when we have a .py file (development).
    # Otherwise drive the installed assembler binary as a subprocess.
    if str(PDP10_ASM).endswith('.py'):
        pdp10_asm_mod = load_module_from_path('pdp10_asm', PDP10_ASM)
        words, labels, _pool = assemble_sources(pdp10_asm_mod, asm_sources, start_addr)
        dxr_path = None
    else:
        print(f"Note: driving assembler as binary ({PDP10_ASM})")
        dxr_path, labels = assemble_with_binary(PDP10_ASM, asm_sources,
                                                start_addr, workdir, base_name)
        words = []

    expects = parse_expect(args.expect)

    deposit_path = workdir / (base_name + '.simh')
    rim_path = workdir / (base_name + '.rim')
    run_path = workdir / (base_name + '-run.ini')
    log_path = workdir / (base_name + '.out')
    labels_path = workdir / (base_name + '.labels')
    report_path = Path(args.report).expanduser().resolve() if args.report else workdir / (base_name + '.report.txt')

    entry = entry_for(labels, start_addr)
    if dxr_path is None:
        entry = write_deposit(words, labels, start_addr, deposit_path)
    else:
        convert_dxr(dxr_path, deposit_path, 'simh', start_addr)

    if args.mode == 'rim' and dxr_path is None:
        if str(MKRIM).endswith('.py') or os.environ.get('MKRIM'):
            mkrim_mod = load_module_from_path('mkrim', MKRIM)
            rim_entry = write_rim(mkrim_mod, words, labels, start_addr, rim_path)
        else:
            print(f"Note: driving mkrim as binary ({MKRIM})")
            rim_entry = write_rim_with_binary(MKRIM, asm_sources, start_addr, rim_path)

        if rim_entry != entry:
            raise SystemExit('internal error: RIM entry %o != deposit entry %o' % (rim_entry, entry))
    elif args.mode == 'rim':
        convert_dxr(dxr_path, rim_path, 'rim', start_addr)
    write_labels(labels, labels_path)

    ini_files: List[Path] = []
    if not args.no_default_ini:
        ini_files.extend(find_default_ini(machine, workdir, toolsdir))
    for ini in args.ini:
        ini_files.append(resolve_ini(ini, workdir, toolsdir))

    image_path = rim_path if args.mode == 'rim' else deposit_path
    run_script = make_run_script(args, machine, labels, entry, image_path, expects, ini_files)
    run_path.write_text(run_script)

    print('machine: %s' % machine)
    print('mode:    %s' % args.mode)
    print('simh:    %s' % simh)
    print('assembler: %s' % PDP10_ASM)
    print('mkrim:     %s' % MKRIM)
    print('gcc:       %s' % PDP10_GCC)
    print('toolsdir:  %s' % toolsdir)
    print('workdir: %s' % workdir)
    print('image:   %s' % image_path)
    print('script:  %s' % run_path)
    print('log:     %s' % log_path)
    print('labels:  %s' % labels_path)
    print('report:  %s' % report_path)
    print('entry:   %o' % entry)

    try:
        proc = subprocess.Popen([str(simh), str(run_path)], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, cwd=str(start_pwd))
        out, _ = proc.communicate(timeout=args.timeout)
        rc = proc.returncode
    except subprocess.TimeoutExpired:
        proc.kill()
        out, _ = proc.communicate()
        rc = 124

    text = out.decode('utf-8', 'replace')
    log_path.write_text(text)

    failures: List[str] = []
    if rc != 0:
        failures.append('SIMH exited with status %s' % rc)

    for pat in ('Format error', 'Non-existent memory', 'Unknown command',
                'Invalid argument', 'Command not allowed', 'Illegal instruction'):
        if pat.lower() in text.lower():
            failures.append('SIMH output contains: %s' % pat)

    if 'Breakpoint, PC: 000020' in text:
        failures.append('low-core break reached PC 000020')

    parsed = parse_marked_values(text, '__P10BARE_EXPECT__')
    for item in parsed:
        if item['got'] is None:
            failures.append('%s: no readable examine output' % item['name'])
        elif item['want'] is None:
            failures.append('%s: no expected value parsed' % item['name'])
        elif ((item['got'] ^ item['want']) & MASK36) != 0:
            failures.append('%s: got %s expected %s' % (item['name'], fmt36(item['got']), fmt36(item['want'])))
    expect_names = {name for name, _ in expects}
    got_names = {item['name'] for item in parsed}
    for name in sorted(expect_names - got_names):
        failures.append('%s: expectation marker missing from SIMH output' % name)

    artifacts = {
        'rim': rim_path,
        'deposit': deposit_path,
        'script': run_path,
        'log': log_path,
        'labels': labels_path,
        'report': report_path,
    }
    write_report(report_path, args, machine, simh, PDP10_ASM, MKRIM, PDP10_GCC, start_pwd,
                 workdir, toolsdir, start_addr, entry, raw_sources, asm_sources,
                 ini_files, labels, rc, text, failures, artifacts)

    if failures:
        for fail in failures:
            sys.stderr.write('FAIL: %s\n' % fail)
        sys.stderr.write('see report: %s\n' % report_path)
        return 1

    print('PASS %s on %s' % (base_name, machine))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
