else:
    MKRIM = SCRIPT_DIR / 'mkrim.py'

DXRCONVERT = _resolve_tool('dxrconvert', 'DXRCONVERT', 'dxrconvert')

# Emulator paths - respect the same variables as the main Makefile.
def _resolve_simh(name: str, env_var: str) -> Path:
    if env_var in os.environ:
        return Path(os.environ[env_var])

    prefixed = PDP10_PREFIX / 'bin' / name
    if prefixed.exists():
        return prefixed

    local = SCRIPT_DIR / name
    if local.exists():
        return local

    found = shutil.which(name)
    if found:
        return Path(found)

    return local

