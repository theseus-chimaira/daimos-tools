import subprocess
import sys
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Sequence, Tuple

MASK36 = (1 << 36) - 1
TOOL_TIMEOUT = int(os.environ.get('PDP10_TOOL_TIMEOUT', '30'))

SCRIPT_DIR = Path(__file__).resolve().parent
if 'PDP10_PREFIX' not in os.environ:
    raise SystemExit('error: PDP10_PREFIX must be set')
PDP10_PREFIX = Path(os.environ['PDP10_PREFIX'])
P10BARE_VERSION = "p10bare-label-contract-v4_20260601a+libgcc1-v1_20260616a"


LIBGCC1_MACROS = [
    'Lpdp10_bare_runtime',
    'LBADL6', 'LBADL7', 'LBADL8', 'LBADL9', 'LBADLH',
    'LBADX6', 'LBADX7', 'LBADX8', 'LBADX9', 'LBADXH',
]


def _strip_c_comments(text: str) -> str:
    return re.sub(r'/\*.*?\*/', '', text, flags=re.S)


def _simplify_indexed_disp(line: str) -> str:
    pat = re.compile(r'(?<![A-Za-z0-9_])(-?[0-9]+)\s*\+\s*(-?[0-9]+)(?=\([0-7]{1,2}\))')

    def repl(m: re.Match[str]) -> str:
        val = int(m.group(1), 10) + int(m.group(2), 10)
        return ('-' + format(-val, 'o')) if val < 0 else format(val, 'o')

    return pat.sub(repl, line)


def _normalize_libgcc1_asm(raw_text: str) -> str:
    text = _strip_c_comments(raw_text)
    out: List[str] = []
    for raw in text.splitlines():
        line = raw.rstrip().replace('\r', '')
        stripped = line.strip()
        upper = stripped.upper()
        if not stripped:
            continue
        if re.match(r'^TITLE(?:\s|$)', upper):
            continue
        if re.match(r'^ENTRY(?:\s|$)', upper):
            out.append(stripped)
            continue
        if upper == 'END' or re.match(r'^END\s+', upper):
            continue
        if re.match(r'^\.ENDPS(?:\s|$)', upper):
            continue
        if re.match(r'^\.PSECT(?:\s|$)', upper):
            low = stripped.lower()
            if '.text' in low:
                out.append('.text')
            elif '.rodata' in low or '.rdata' in low or '.data' in low:
                out.append('.data')
            elif '.bss' in low:
                out.append('.bss')
            else:
                out.append('.text')
            continue
        out.append(_simplify_indexed_disp(line))
    return '\n'.join(out) + '\n'


def _asm_defines_label(text: str, name: str) -> bool:
    return re.search(r'(?m)^' + re.escape(name) + r':', text) is not None


def prepare_libgcc1_sources(args, workdir: Path) -> List[Path]:
    if not args.libgcc1:
        return []

    libgcc1 = Path(args.libgcc1).expanduser()
    if not libgcc1.is_absolute():
        libgcc1 = (Path.cwd() / libgcc1).resolve()
    if not libgcc1.is_file():
        raise SystemExit('libgcc1.s not found: %s' % libgcc1)

    cpp = args.cpp
    if shutil.which(cpp) is None:
        raise SystemExit('cpp not found: %s' % cpp)

    gen_dir = workdir / 'p10bare-gen' / 'libgcc1'
    if gen_dir.exists():
        for old in gen_dir.glob('*.s'):
            old.unlink()
    gen_dir.mkdir(parents=True, exist_ok=True)

    units: List[Path] = []
    seen: Dict[str, str] = {}
    combined = ''
    for nr, macro in enumerate(LIBGCC1_MACROS, 1):
        safe = re.sub(r'[^A-Za-z0-9_.-]', '_', macro)
        cmd = [
            cpp, '-P', '-x', 'assembler-with-cpp', '-D' + macro,
            '-D__REGPARM__=' + str(args.regparm),
            '-DUNDERSCORE=' + str(args.underscore),
            str(libgcc1),
        ]
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr or '')
            raise SystemExit('cpp failed for %s in %s' % (macro, libgcc1))
        norm = _normalize_libgcc1_asm(proc.stdout)
        fingerprint = '\n'.join(line.rstrip() for line in norm.splitlines() if line.strip())
        digest = hashlib.sha256(fingerprint.encode('utf-8')).hexdigest()
        if digest in seen:
            continue
        seen[digest] = macro
        unit = gen_dir / ('%03d-%s.s' % (nr, safe))
        unit.write_text(norm)
        units.append(unit)
        combined += norm

    if not _asm_defines_label(combined, '__main'):
        unit = gen_dir / '000-bare-__main-fallback.s'
        unit.write_text('.text\n\t.globl\t__main\n__main:\n\tpopj 17,\n')
        units.insert(0, unit)

    list_path = gen_dir / 'units.list'
    list_path.write_text('\n'.join(str(p) for p in units) + ('\n' if units else ''))
    return units

# --- Tool resolution helpers -------------------------------------------------

def _resolve_tool(name: str, env_var: str, local_name: str) -> Path:
    """
    Resolve a tool preferring:
      1. Explicit environment variable (e.g. PDP10_AS=/opt/bin/foo)
      2. System installation under PDP10_PREFIX/bin
      3. Local copy next to this script (development)
    """
    # 1. Explicit override
    if env_var in os.environ:
        return Path(os.environ[env_var])

    # 2. System location
    system_path = PDP10_PREFIX / 'bin' / name
    if system_path.exists():
        return system_path

    # 3. Local development copy
    return SCRIPT_DIR / local_name


